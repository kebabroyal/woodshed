export GI_TYPELIB_PATH="@TYPELIB_DIR@${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
export LD_LIBRARY_PATH="@LIB_DIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export WOODSHED_APP_ID="@APP_ID@"
